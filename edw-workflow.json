            "parameters": {
                "jsCode": "// 1. Reference the data directly without creating a large variable\nconst input = $input.all()[0].json;\n\n// 2. Find the array in your SQL result (e.g., 'rows', 'data', or the object itself)\nconst dataArray = Object.values(input).find(val => Array.isArray(val)) || (Array.isArray(input) ? input : []);\n\n// 3. Use .map() to return the items in the EXACT format n8n requires\nreturn dataArray.map(row => {\n  return {\n    json: (typeof row === 'object' && row !== null) ? row : { value: row }\n  };\n});"
